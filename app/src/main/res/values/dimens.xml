<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- MD3 形状角半径阶梯（corner_small=chips/menu，corner_medium=cards，
         corner_large=FAB/drawer，corner_extra_large=dialog/sheet）。
         新视图一律引用此处的 token，不再写魔法数。 -->
    <dimen name="corner_small">8dp</dimen>
    <dimen name="corner_medium" tools:ignore="UnusedResources">12dp</dimen>
    <dimen name="corner_large" tools:ignore="UnusedResources">16dp</dimen>
    <dimen name="corner_extra_large" tools:ignore="UnusedResources">28dp</dimen>

    <!-- Widget 既有视觉：卡片 22dp、左侧色条 3dp，token 化但不改值 -->
    <dimen name="corner_widget">22dp</dimen>
    <dimen name="corner_widget_accent">3dp</dimen>

    <!-- 课表网格断点尺寸（手机值；平板覆盖见 values-sw600dp/dimens.xml）。
         ScheduleBoardView 与 MainActivity 顶栏/侧栏对齐计算共用，Java 经
         getDimensionPixelSize 读取，勿在代码里另写魔法数。 -->
    <dimen name="board_time_width">34dp</dimen>
    <dimen name="board_day_min_width">38dp</dimen>
    <dimen name="board_day_max_width">110dp</dimen>
    <dimen name="content_column_width_tablet">640dp</dimen>
    <dimen name="tablet_sidebar_width">320dp</dimen>

    <!-- 计划页悬浮新增菜单（1.26.0）：尺寸与间距由 Java 经资源读取，新视图勿写魔法数。 -->
    <dimen name="plan_fab_size">56dp</dimen>
    <dimen name="plan_fab_icon_size">24dp</dimen>
    <dimen name="plan_fab_nav_gap">12dp</dimen>
    <dimen name="plan_fab_menu_gap">12dp</dimen>
    <dimen name="plan_add_menu_row_min_height">48dp</dimen>
    <dimen name="plan_add_menu_row_gap">8dp</dimen>
    <dimen name="plan_add_menu_row_padding_h">14dp</dimen>
    <dimen name="plan_add_menu_row_icon_gap">10dp</dimen>
    <dimen name="plan_add_menu_row_radius">24dp</dimen>
    <dimen name="plan_list_tail_gap">12dp</dimen>
</resources>
