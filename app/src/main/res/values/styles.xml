<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:navigationBarColor">@color/page_bg</item>
    </style>

    <!-- 顶部下拉面板（实践课程等）专用窗口动画：平移+淡入淡出，
         不使用系统 Dialog 的缩放动画（缩放会让毛玻璃面板看起来抖动）。 -->
    <style name="PolarisDropdownPopup" parent="">
        <item name="android:windowEnterAnimation">@anim/polaris_popup_drop_enter</item>
        <item name="android:windowExitAnimation">@anim/polaris_popup_drop_exit</item>
    </style>

    <!-- Widget 类型标尺（MD3 typescale 子集）。颜色按角色留在布局里，样式只管字号/字重。 -->
    <style name="TextAppearance.Polaris.Widget" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.Polaris.Widget.TitleSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Polaris.Widget.BodyMedium">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Polaris.Widget.BodyMediumEmphasized">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Polaris.Widget.BodySmall">
        <item name="android:textSize">11sp</item>
    </style>
</resources>
